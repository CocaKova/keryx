    <!-- The app's guided tour (Settings › About › Take the tour). Each stop: a short title and a sentence or two. -->
    <string name="app_tour_welcome_title">Welcome to Keryx</string>
    <string name="app_tour_welcome_text">This is a demo: a pretend gateway on your phone, and its agent is in the middle of a job. Here\'s a quick look around before you connect your own.</string>
    <!-- The agent's step-by-step plan for a job. -->
    <string name="app_tour_plan_title">Its plan</string>
    <string name="app_tour_plan_text">Your agent breaks a job into steps and ticks them off as it goes. While it works, Keryx keeps a live notice of the job, so you can put the phone away.</string>
    <string name="app_tour_approval_title">It asks first</string>
    <string name="app_tour_approval_text">Before anything risky, like deleting a folder, your agent stops and asks. Answer here or right from the notification.</string>
    <!-- The demo's version of the stop above; keep "Try it" as an invitation to tap the approval. -->
    <string name="app_tour_approval_text_demo">Before anything risky, like deleting a folder, your agent stops and asks. Answer here or right from the notification. Try it when the tour\'s done, and watch it finish the job.</string>
    <string name="app_tour_composer_title">Ask for anything</string>
    <string name="app_tour_composer_text">Give your agent a job in plain words. It keeps working if you leave, and Keryx lets you know when it\'s done.</string>
    <!-- "Brain" = the AI model. -->
    <string name="app_tour_model_title">Which brain answers</string>
    <string name="app_tour_model_text">Switch the model for this session, or for every session from here on.</string>
    <string name="app_tour_new_session_title">A fresh page</string>
    <string name="app_tour_new_session_text">Start a new session. Hold it for options, like a title or a temporary session.</string>
    <string name="app_tour_drawer_title">Everything else</string>
    <string name="app_tour_drawer_text">Your sessions and the rest of Keryx are behind this button.</string>
    <string name="app_tour_lenses_title">What needs you</string>
    <string name="app_tour_lenses_text">Narrow the list to sessions waiting on you, running right now, or unread.</string>
    <!-- Name of a place in the app: a board of longer jobs. -->
    <string name="app_tour_missions_title">Missions</string>
    <string name="app_tour_missions_text">Hand your agent longer jobs as cards on a board. It works through them and asks when it needs you.</string>
    <!-- Name of a place in the app: scheduled jobs. -->
    <string name="app_tour_runs_title">Runs</string>
    <string name="app_tour_runs_text">Scheduled jobs, and what each run turned up.</string>
    <!-- Name of a place in the app: the agent's profiles. -->
    <string name="app_tour_bots_title">Bots</string>
    <string name="app_tour_bots_text">Your agent\'s other profiles. Each keeps its own memory, skills and chats.</string>
    <!-- Name of a place in the app: the searchable history. -->
    <string name="app_tour_archive_title">Archive</string>
    <string name="app_tour_archive_text">Everything ever said, searchable on the phone, even with the gateway down.</string>
    <!-- The gateway is the Hermes server the app talks to. -->
    <string name="app_tour_gateway_title">Your gateway</string>
    <string name="app_tour_gateway_text_demo">With your own Hermes, this shows the link, the model and the version. Everything you just saw works the same on a real gateway: connect yours and it\'s live.</string>
    <string name="app_tour_gateway_text">The link, the model and the Hermes version. Tap it for the Gateway; the gear opens Settings, where this tour lives too.</string>
    <string name="app_tour_gateway_text_direct">The link, the model and the Hermes version. Tap it for the Gateway; the gear opens Settings, where this tour lives too. Run more than one Hermes? Add it and switch between them here.</string>
    <!-- Button ending the demo's tour. -->
    <string name="app_tour_cta_connect">Connect your gateway</string>
    <!-- Button ending the tour. -->
    <string name="app_tour_cta_add_gateway">Add a gateway</string>

    <!-- What's new in 3.0 (a short tour shown once after updating) -->
    <string name="app_whatsnew_title">What\'s new in Keryx 3.0</string>
    <string name="app_whatsnew_text">A quick look at what changed. Skip it if you like: it stays in Settings › About.</string>
    <string name="app_whatsnew_point_title">Ask where something is</string>
    <!-- Keep "keryx-stream 0.6" as is (a plugin name and version). -->
    <string name="app_whatsnew_point_text">Ask your agent \"where are my scheduled jobs?\" and it can point at the place, right here on the phone. Your gateway needs keryx-stream 0.6 or newer.</string>
    <string name="app_whatsnew_memory_title">Chat memory</string>
    <string name="app_whatsnew_memory_text">The ring beside the model now says how many replies this chat has room for, and only once it matters. Tap it to see what\'s using the room.</string>
    <!-- The drawer = the side menu. -->
    <string name="app_whatsnew_drawer_title">A redrawn drawer</string>
    <string name="app_whatsnew_drawer_text_direct">Each chat has its own colour and mark, a ring shows the ones at work, and these filters narrow the list to what needs you.</string>
    <string name="app_whatsnew_drawer_text">Each chat has its own colour and mark, and a ring shows the ones at work.</string>
    <string name="app_whatsnew_cards_title">Cards in plain words</string>
    <!-- "Details" names a section on the card. -->
    <string name="app_whatsnew_cards_text">A mission card now opens on what\'s going on and the one thing to do next. The technical details are still there, under Details.</string>
    <string name="app_whatsnew_look_title">Look and updates</string>
    <!-- Keep "keryx-stream" and the command "hermes keryx pair" as is. "Stable" and "Edge" are release channel names. -->
    <string name="app_whatsnew_look_text_direct">Settings › Appearance has new thinking styles and five ways to move between chats. With a recent keryx-stream, the Gateway\'s Update panel lets you pick Stable releases or Edge. To add another Hermes, run hermes keryx pair on it and scan the code.</string>
    <string name="app_whatsnew_look_text">Settings › Appearance has new thinking styles and five ways to move between chats. The tour and the space hints live in Settings › About.</string>

    <!-- First-visit hints: one card the first time a place opens -->
    <string name="app_hint_missions_title">Missions</string>
    <string name="app_hint_missions_text">Longer jobs live here as cards. Your agents pick them up and work through them, and a card that needs you moves to the top. Tap + to hand one out.</string>
    <string name="app_hint_runs_title">Runs</string>
    <string name="app_hint_runs_text">Jobs on a schedule, like a morning brief or a nightly check. Each run\'s result lands here. Ask your agent and it can set one up for you.</string>
    <string name="app_hint_bots_title">Bots</string>
    <string name="app_hint_bots_text">Each bot is a profile of your Hermes, with its own memory, skills and chats. Open one to talk to it, or put a few in a group chat.</string>
    <string name="app_hint_gateway_title">Your gateway</string>
    <string name="app_hint_gateway_text">How the Hermes you\'re connected to is doing, and what\'s behind it: its model and settings, jobs, skills, memory and tools.</string>
    <!-- Name of a full-screen view of the agent at work. -->
    <string name="app_hint_tapin_title">Tap-In</string>
    <string name="app_hint_tapin_text">Your agent at work, full screen: what it\'s thinking, the tools it runs and the helpers it sends out. You can steer it from here too.</string>
    <string name="app_hint_artifact_title">A page your agent made</string>
    <string name="app_hint_artifact_text">Reports, mock-ups and pages your agent writes open here, on the phone. Save one or share it with the buttons up top.</string>

