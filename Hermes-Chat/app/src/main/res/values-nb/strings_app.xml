    <string name="app_tour_welcome_title">Velkommen til Keryx</string>
    <string name="app_tour_welcome_text">Dette er en demo: en late-som-gateway på telefonen din, og agenten er midt i en jobb. Her er en rask omvisning før du kobler til din egen.</string>
    <string name="app_tour_plan_title">Planen</string>
    <string name="app_tour_plan_text">Agenten din deler en jobb opp i steg og krysser dem av underveis. Mens den jobber, viser Keryx et løpende varsel om jobben, så du kan legge bort telefonen.</string>
    <string name="app_tour_approval_title">Den spør først</string>
    <string name="app_tour_approval_text">Før noe risikabelt, som å slette en mappe, stopper agenten og spør. Svar her eller rett fra varselet.</string>
    <string name="app_tour_approval_text_demo">Før noe risikabelt, som å slette en mappe, stopper agenten og spør. Svar her eller rett fra varselet. Prøv det når omvisningen er ferdig, og se den fullføre jobben.</string>
    <string name="app_tour_composer_title">Spør om hva som helst</string>
    <string name="app_tour_composer_text">Gi agenten din en jobb med vanlige ord. Den fortsetter å jobbe om du går, og Keryx sier fra når den er ferdig.</string>
    <string name="app_tour_model_title">Hvilken hjerne som svarer</string>
    <string name="app_tour_model_text">Bytt modell for denne økten, eller for alle økter fra nå av.</string>
    <string name="app_tour_new_session_title">En blank side</string>
    <string name="app_tour_new_session_text">Start en ny økt. Hold inne for flere valg, som en tittel eller en midlertidig økt.</string>
    <string name="app_tour_drawer_title">Alt det andre</string>
    <string name="app_tour_drawer_text">Øktene dine og resten av Keryx ligger bak denne knappen.</string>
    <string name="app_tour_lenses_title">Hva som venter på deg</string>
    <string name="app_tour_lenses_text">Begrens listen til økter som venter på deg, kjører akkurat nå eller er uleste.</string>
    <string name="app_tour_missions_title">Oppdrag</string>
    <string name="app_tour_missions_text">Gi agenten lengre jobber som kort på en tavle. Den jobber seg gjennom dem og spør når den trenger deg.</string>
    <string name="app_tour_runs_title">Kjøringer</string>
    <string name="app_tour_runs_text">Planlagte jobber, og hva hver kjøring fant.</string>
    <string name="app_tour_bots_title">Boter</string>
    <string name="app_tour_bots_text">Agentens andre profiler. Hver har sitt eget minne, ferdigheter og chatter.</string>
    <string name="app_tour_archive_title">Arkiv</string>
    <string name="app_tour_archive_text">Alt som noen gang er sagt, søkbart på telefonen, selv når gatewayen er nede.</string>
    <string name="app_tour_gateway_title">Gatewayen din</string>
    <string name="app_tour_gateway_text_demo">Med din egen Hermes viser dette tilkoblingen, modellen og versjonen. Alt du nettopp så, fungerer likt på en ekte gateway: koble til din, så er den live.</string>
    <string name="app_tour_gateway_text">Tilkoblingen, modellen og Hermes-versjonen. Trykk for Gateway; tannhjulet åpner Innstillinger, der denne omvisningen også bor.</string>
    <string name="app_tour_gateway_text_direct">Tilkoblingen, modellen og Hermes-versjonen. Trykk for Gateway; tannhjulet åpner Innstillinger, der denne omvisningen også bor. Kjører du mer enn én Hermes? Legg den til og bytt mellom dem her.</string>
    <string name="app_tour_cta_connect">Koble til gatewayen din</string>
    <string name="app_tour_cta_add_gateway">Legg til en gateway</string>

    <string name="app_whatsnew_title">Nytt i Keryx 3.0</string>
    <string name="app_whatsnew_text">En rask titt på hva som er endret. Hopp over om du vil: det ligger også i Innstillinger › Om.</string>
    <string name="app_whatsnew_point_title">Spør hvor noe er</string>
    <string name="app_whatsnew_point_text">Spør agenten «hvor er de planlagte jobbene mine?», så kan den peke på stedet, rett her på telefonen. Gatewayen din trenger keryx-stream 0.6 eller nyere.</string>
    <string name="app_whatsnew_memory_title">Chatminne</string>
    <string name="app_whatsnew_memory_text">Ringen ved siden av modellen viser nå hvor mange svar denne chatten har plass til, og bare når det betyr noe. Trykk på den for å se hva som bruker plassen.</string>
    <string name="app_whatsnew_drawer_title">En ny sidemeny</string>
    <string name="app_whatsnew_drawer_text_direct">Hver chat har sin egen farge og sitt eget merke, en ring viser de som jobber, og disse filtrene begrenser listen til det som venter på deg.</string>
    <string name="app_whatsnew_drawer_text">Hver chat har sin egen farge og sitt eget merke, og en ring viser de som jobber.</string>
    <string name="app_whatsnew_cards_title">Kort med vanlige ord</string>
    <string name="app_whatsnew_cards_text">Et oppdragskort åpner nå med hva som skjer og den ene tingen som skal gjøres nå. De tekniske detaljene er fortsatt der, under Detaljer.</string>
    <string name="app_whatsnew_look_title">Utseende og oppdateringer</string>
    <string name="app_whatsnew_look_text_direct">Innstillinger › Utseende har nye tenkestiler og fem måter å bytte mellom chatter på. Med en nyere keryx-stream kan du i Gatewayens Oppdater-panel velge Stabil eller Edge. For å legge til en annen Hermes kjører du hermes keryx pair på den og skanner koden.</string>
    <string name="app_whatsnew_look_text">Innstillinger › Utseende har nye tenkestiler og fem måter å bytte mellom chatter på. Omvisningen og tipsene for hvert område ligger i Innstillinger › Om.</string>

    <string name="app_hint_missions_title">Oppdrag</string>
    <string name="app_hint_missions_text">Lengre jobber ligger her som kort. Agentene dine plukker dem opp og jobber seg gjennom dem, og et kort som trenger deg, flyttes til toppen. Trykk + for å dele ut et.</string>
    <string name="app_hint_runs_title">Kjøringer</string>
    <string name="app_hint_runs_text">Jobber etter en tidsplan, som en morgenbrief eller en nattlig sjekk. Resultatet av hver kjøring havner her. Spør agenten, så kan den sette opp en for deg.</string>
    <string name="app_hint_bots_title">Boter</string>
    <string name="app_hint_bots_text">Hver bot er en profil i Hermes-en din, med eget minne, ferdigheter og chatter. Åpne en for å snakke med den, eller samle noen i en gruppechat.</string>
    <string name="app_hint_gateway_title">Gatewayen din</string>
    <string name="app_hint_gateway_text">Hvordan det går med Hermes-en du er koblet til, og hva som ligger bak: modellen og innstillingene, jobber, ferdigheter, minne og verktøy.</string>
    <string name="app_hint_tapin_title">Tap-In</string>
    <string name="app_hint_tapin_text">Agenten din i arbeid, i fullskjerm: hva den tenker, verktøyene den kjører og hjelperne den sender ut. Du kan også styre den herfra.</string>
    <string name="app_hint_artifact_title">En side agenten din har laget</string>
    <string name="app_hint_artifact_text">Rapporter, skisser og sider agenten skriver, åpnes her på telefonen. Lagre eller del dem med knappene øverst.</string>

