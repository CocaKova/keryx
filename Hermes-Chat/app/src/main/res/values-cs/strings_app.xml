    <string name="app_tour_welcome_title">Vítej v Keryx</string>
    <string name="app_tour_welcome_text">Tohle je ukázka: předstíraná brána v tvém telefonu a její agent je zrovna uprostřed práce. Rychle se tu rozhlédni, než připojíš vlastní.</string>
    <string name="app_tour_plan_title">Jeho plán</string>
    <string name="app_tour_plan_text">Agent rozdělí práci na kroky a průběžně je odškrtává. Během práce Keryx zobrazuje živé oznámení, takže můžeš telefon odložit.</string>
    <string name="app_tour_approval_title">Nejdřív se zeptá</string>
    <string name="app_tour_approval_text">Před čímkoli riskantním, třeba smazáním složky, se agent zastaví a zeptá. Odpověz tady nebo rovnou z oznámení.</string>
    <string name="app_tour_approval_text_demo">Před čímkoli riskantním, třeba smazáním složky, se agent zastaví a zeptá. Odpověz tady nebo rovnou z oznámení. Zkus to po skončení prohlídky a sleduj, jak práci dokončí.</string>
    <string name="app_tour_composer_title">Požádej o cokoli</string>
    <string name="app_tour_composer_text">Zadej agentovi práci obyčejnými slovy. Pracuje dál, i když odejdeš, a Keryx ti dá vědět, až bude hotovo.</string>
    <string name="app_tour_model_title">Který mozek odpovídá</string>
    <string name="app_tour_model_text">Přepni model pro tuto relaci, nebo pro všechny další.</string>
    <string name="app_tour_new_session_title">Čistý list</string>
    <string name="app_tour_new_session_text">Začni novou relaci. Podrž pro možnosti, jako je název nebo dočasná relace.</string>
    <string name="app_tour_drawer_title">Všechno ostatní</string>
    <string name="app_tour_drawer_text">Tvé relace a zbytek Keryx najdeš za tímto tlačítkem.</string>
    <string name="app_tour_lenses_title">Co čeká na tebe</string>
    <string name="app_tour_lenses_text">Zuž seznam na relace, které čekají na tebe, právě běží nebo jsou nepřečtené.</string>
    <string name="app_tour_missions_title">Mise</string>
    <string name="app_tour_missions_text">Svěř agentovi delší práci jako karty na nástěnce. Postupně je zpracuje a zeptá se, když tě bude potřebovat.</string>
    <string name="app_tour_runs_title">Běhy</string>
    <string name="app_tour_runs_text">Naplánované úlohy a co který běh přinesl.</string>
    <string name="app_tour_bots_title">Boti</string>
    <string name="app_tour_bots_text">Další profily tvého agenta. Každý má vlastní paměť, dovednosti a chaty.</string>
    <string name="app_tour_archive_title">Archiv</string>
    <string name="app_tour_archive_text">Všechno, co kdy padlo, prohledatelné v telefonu, i když brána neběží.</string>
    <string name="app_tour_gateway_title">Tvá brána</string>
    <string name="app_tour_gateway_text_demo">S vlastním Hermesem tu uvidíš spojení, model a verzi. Všechno, co jsi právě viděl, funguje stejně na skutečné bráně: připoj svou a je to naživo.</string>
    <string name="app_tour_gateway_text">Spojení, model a verze Hermesu. Klepnutím otevřeš Bránu; ozubené kolo otevře Nastavení, kde najdeš i tuto prohlídku.</string>
    <string name="app_tour_gateway_text_direct">Spojení, model a verze Hermesu. Klepnutím otevřeš Bránu; ozubené kolo otevře Nastavení, kde najdeš i tuto prohlídku. Máš víc než jeden Hermes? Přidej ho a přepínej mezi nimi tady.</string>
    <string name="app_tour_cta_connect">Připojit svou bránu</string>
    <string name="app_tour_cta_add_gateway">Přidat bránu</string>

    <string name="app_whatsnew_title">Co je nového v Keryx 3.0</string>
    <string name="app_whatsnew_text">Rychlý přehled změn. Klidně přeskoč: zůstane v Nastavení › O aplikaci.</string>
    <string name="app_whatsnew_point_title">Zeptej se, kde co je</string>
    <string name="app_whatsnew_point_text">Zeptej se agenta „kde mám naplánované úlohy?“ a ukáže ti to místo přímo tady v telefonu. Tvá brána potřebuje keryx-stream 0.6 nebo novější.</string>
    <string name="app_whatsnew_memory_title">Paměť chatu</string>
    <string name="app_whatsnew_memory_text">Kroužek u modelu teď ukazuje, na kolik odpovědí ještě v tomto chatu zbývá místo, a to jen tehdy, když na tom záleží. Klepni a uvidíš, co místo zabírá.</string>
    <string name="app_whatsnew_drawer_title">Překreslený panel</string>
    <string name="app_whatsnew_drawer_text_direct">Každý chat má vlastní barvu a značku, kroužek ukazuje ty, které pracují, a filtry zúží seznam na to, co čeká na tebe.</string>
    <string name="app_whatsnew_drawer_text">Každý chat má vlastní barvu a značku a kroužek ukazuje ty, které pracují.</string>
    <string name="app_whatsnew_cards_title">Karty srozumitelně</string>
    <string name="app_whatsnew_cards_text">Karta mise se teď otevře tím, co se děje, a jedinou věcí, kterou je třeba udělat. Technické detaily jsou pořád v sekci Podrobnosti.</string>
    <string name="app_whatsnew_look_title">Vzhled a aktualizace</string>
    <string name="app_whatsnew_look_text_direct">Nastavení › Vzhled má nové styly přemýšlení a pět způsobů přechodu mezi chaty. S novějším keryx-stream si v panelu Aktualizace na Bráně vybereš vydání Stable nebo Edge. Chceš přidat další Hermes? Spusť na něm hermes keryx pair a naskenuj kód.</string>
    <string name="app_whatsnew_look_text">Nastavení › Vzhled má nové styly přemýšlení a pět způsobů přechodu mezi chaty. Prohlídka a nápovědy jsou v Nastavení › O aplikaci.</string>
    <string name="app_whatsnew_more_text">Místa si pamatují, kde jste byli, a po odbočce vás štítek vrátí zpět. Zamkněte dovednost, aby ji agent nemohl měnit. Světlý a tmavý režim mají každý své barvy.</string>
    <string name="app_whatsnew_more_title">Drobnosti</string>
    <string name="app_whatsnew_board_text">Karty teď leží ve sloupcích, mezi kterými přejíždíte, a můžete mít víc než jednu nástěnku.</string>
    <string name="app_whatsnew_board_title">Mise na nástěnce</string>
    <string name="app_tour_bot_lights_text">Klepnutím na bota otevřete jeho chat, podržením ho spravujete. Dýchající kroužek znamená, že pracuje.</string>
    <string name="app_tour_bot_lights_title">Vaši boti</string>

    <string name="app_hint_missions_title">Mise</string>
    <string name="app_hint_missions_text">Tady bydlí delší práce jako karty. Tví agenti si je berou a zpracovávají, a karta, která tě potřebuje, se přesune nahoru. Klepni na + a nějakou zadej.</string>
    <string name="app_hint_runs_title">Běhy</string>
    <string name="app_hint_runs_text">Úlohy podle plánu, třeba ranní přehled nebo noční kontrola. Výsledek každého běhu přistane tady. Požádej agenta a nastaví ti ji.</string>
    <string name="app_hint_bots_title">Boti</string>
    <string name="app_hint_bots_text">Každý bot je profil tvého Hermesu s vlastní pamětí, dovednostmi a chaty. Otevři jednoho a mluv s ním, nebo jich pár dej do skupinového chatu.</string>
    <string name="app_hint_gateway_title">Tvá brána</string>
    <string name="app_hint_gateway_text">Jak se daří Hermesu, ke kterému jsi připojený, a co je za ním: model a nastavení, úlohy, dovednosti, paměť a nástroje.</string>
    <string name="app_hint_tapin_title">Tap-In</string>
    <string name="app_hint_tapin_text">Agent při práci na celé obrazovce: co si myslí, jaké nástroje spouští a jaké pomocníky vysílá. I odsud ho můžeš směrovat.</string>
    <string name="app_hint_artifact_title">Stránka od agenta</string>
    <string name="app_hint_artifact_text">Zprávy, makety a stránky, které agent napíše, se otevírají tady v telefonu. Ulož nebo sdílej je tlačítky nahoře.</string>

