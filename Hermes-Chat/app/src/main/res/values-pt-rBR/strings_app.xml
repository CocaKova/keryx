    <string name="app_tour_approval_text_demo">Antes de algo arriscado, como apagar uma pasta, seu agente para e pergunta. Responda aqui ou direto na notificação. Experimente quando o tour acabar e veja ele terminar o trabalho.</string>
    <string name="app_tour_composer_title">Peça o que quiser</string>
    <string name="app_tour_composer_text">Dê um trabalho ao seu agente em palavras simples. Ele continua trabalhando se você sair, e o Keryx avisa quando terminar.</string>
    <!-- "Brain" = the AI model. -->
    <string name="app_tour_model_title">Qual cérebro responde</string>
    <string name="app_tour_model_text">Troque o modelo desta sessão ou de todas as sessões daqui em diante.</string>
    <string name="app_tour_new_session_title">Uma página em branco</string>
    <string name="app_tour_new_session_text">Comece uma nova sessão. Toque e segure para ver opções, como um título ou uma sessão temporária.</string>
    <string name="app_tour_drawer_title">Todo o resto</string>
    <string name="app_tour_drawer_text">Suas sessões e o resto do Keryx ficam atrás deste botão.</string>
    <string name="app_tour_lenses_title">O que precisa de você</string>
    <string name="app_tour_lenses_text">Filtre a lista para sessões esperando por você, rodando agora ou não lidas.</string>
    <!-- Name of a place in the app: a board of longer jobs. -->
    <string name="app_tour_missions_title">Missões</string>
    <string name="app_tour_missions_text">Passe trabalhos mais longos ao seu agente como cartões num quadro. Ele resolve um por um e pergunta quando precisar de você.</string>
    <!-- Name of a place in the app: scheduled jobs. -->
    <string name="app_tour_runs_title">Execuções</string>
    <string name="app_tour_runs_text">Trabalhos agendados e o que cada execução encontrou.</string>
    <!-- Name of a place in the app: the agent's profiles. -->
    <string name="app_tour_bots_title">Bots</string>
    <string name="app_tour_bots_text">Os outros perfis do seu agente. Cada um tem sua própria memória, habilidades e chats.</string>
    <!-- Name of a place in the app: the searchable history. -->
    <string name="app_tour_archive_title">Arquivo</string>
    <string name="app_tour_archive_text">Tudo o que já foi dito, pesquisável no celular, mesmo com o gateway fora do ar.</string>
    <!-- The gateway is the Hermes server the app talks to. -->
    <string name="app_tour_gateway_title">Seu gateway</string>
    <string name="app_tour_gateway_text_demo">Com seu próprio Hermes, aqui aparecem a conexão, o modelo e a versão. Tudo o que você acabou de ver funciona igual num gateway real: conecte o seu e pronto.</string>
    <string name="app_tour_gateway_text">A conexão, o modelo e a versão do Hermes. Toque para ir ao Gateway; a engrenagem abre as Configurações, onde este tour também fica.</string>
    <string name="app_tour_gateway_text_direct">A conexão, o modelo e a versão do Hermes. Toque para ir ao Gateway; a engrenagem abre as Configurações, onde este tour também fica. Tem mais de um Hermes? Adicione e alterne entre eles aqui.</string>
    <!-- Button ending the demo's tour. -->
    <string name="app_tour_cta_connect">Conectar seu gateway</string>
    <!-- Button ending the tour. -->
    <string name="app_tour_cta_add_gateway">Adicionar um gateway</string>

    <!-- What's new in 3.0 (a short tour shown once after updating) -->
    <string name="app_whatsnew_title">Novidades do Keryx 3.0</string>
    <string name="app_whatsnew_text">Uma olhada rápida no que mudou. Pule se quiser: fica em Configurações › Sobre.</string>
    <string name="app_whatsnew_point_title">Pergunte onde algo está</string>
    <!-- Keep "keryx-stream 0.6" as is (a plugin name and version). -->
    <string name="app_whatsnew_point_text">Pergunte ao seu agente \"onde estão meus trabalhos agendados?\" e ele pode apontar o lugar, aqui mesmo no celular. Seu gateway precisa do keryx-stream 0.6 ou mais recente.</string>
    <string name="app_whatsnew_memory_title">Memória do chat</string>
    <string name="app_whatsnew_memory_text">O anel ao lado do modelo agora mostra quantas respostas ainda cabem neste chat, e só quando importa. Toque nele para ver o que está ocupando o espaço.</string>
    <!-- The drawer = the side menu. -->
    <string name="app_whatsnew_drawer_title">Um menu lateral renovado</string>
    <string name="app_whatsnew_drawer_text_direct">Cada chat tem sua própria cor e marca, um anel mostra os que estão trabalhando, e estes filtros reduzem a lista ao que precisa de você.</string>
    <string name="app_whatsnew_drawer_text">Cada chat tem sua própria cor e marca, e um anel mostra os que estão trabalhando.</string>
    <string name="app_whatsnew_cards_title">Cartões em palavras simples</string>
    <!-- "Details" names a section on the card. -->
    <string name="app_whatsnew_cards_text">Um cartão de missão agora abre mostrando o que está acontecendo e a próxima coisa a fazer. Os detalhes técnicos continuam lá, em Detalhes.</string>
    <string name="app_whatsnew_look_title">Visual e atualizações</string>
    <!-- Keep "keryx-stream" and the command "hermes keryx pair" as is. "Stable" and "Edge" are release channel names. -->
    <string name="app_whatsnew_look_text_direct">Configurações › Aparência tem novos estilos de raciocínio e cinco jeitos de passar de um chat para outro. Com um keryx-stream recente, o painel Atualizar do Gateway deixa você escolher versões Stable ou Edge. Para adicionar outro Hermes, rode hermes keryx pair nele e escaneie o código.</string>
    <string name="app_whatsnew_look_text">Configurações › Aparência tem novos estilos de raciocínio e cinco jeitos de passar de um chat para outro. O tour e as dicas de cada área ficam em Configurações › Sobre.</string>

    <!-- First-visit hints: one card the first time a place opens -->
    <string name="app_hint_missions_title">Missões</string>
    <string name="app_hint_missions_text">Trabalhos mais longos ficam aqui, como cartões. Seus agentes pegam e resolvem cada um, e um cartão que precisa de você sobe para o topo. Toque em + para criar um.</string>
    <string name="app_hint_runs_title">Execuções</string>
    <string name="app_hint_runs_text">Trabalhos agendados, como um resumo matinal ou uma verificação noturna. O resultado de cada execução chega aqui. Peça ao seu agente e ele pode configurar um para você.</string>
    <string name="app_hint_bots_title">Bots</string>
    <string name="app_hint_bots_text">Cada bot é um perfil do seu Hermes, com sua própria memória, habilidades e chats. Abra um para conversar ou junte alguns num chat em grupo.</string>
    <string name="app_hint_gateway_title">Seu gateway</string>
    <string name="app_hint_gateway_text">Como está o Hermes ao qual você está conectado e o que há por trás dele: modelo e configurações, trabalhos, habilidades, memória e ferramentas.</string>
    <!-- Name of a full-screen view of the agent at work. -->
    <string name="app_hint_tapin_title">Tap-In</string>
    <string name="app_hint_tapin_text">Seu agente trabalhando, em tela cheia: o que ele está pensando, as ferramentas que usa e os ajudantes que envia. Você também pode orientá-lo daqui.</string>
    <string name="app_hint_artifact_title">Uma página que seu agente fez</string>
    <string name="app_hint_artifact_text">Relatórios, protótipos e páginas que seu agente escreve abrem aqui, no celular. Salve ou compartilhe com os botões lá em cima.</string>

    <!-- The tour's card -->
    <!-- Accessibility: the name of the tour's card. -->
    <string name="app_tour_pane">Tour</string>
    <!-- Accessibility label of the card's close button. -->
    <string name="app_tour_end">Encerrar o tour</string>
    <!-- Which stop of the tour this is, e.g. "3 of 12". -->
    <string name="app_tour_progress">%1$d de %2$d</string>
    <!-- Button: the previous tour stop. -->
    <string name="app_tour_back">Voltar</string>
    <!-- Button: end the tour. -->
    <string name="app_tour_done">Concluir</string>
    <!-- Button: dismiss a one-off hint. -->
    <string name="app_tour_got_it">Entendi</string>
    <!-- Button: the next tour stop. -->
    <string name="app_tour_next">Próximo</string>
</resources>
