    <string name="app_tour_welcome_title">Tervetuloa Keryxiin</string>
    <string name="app_tour_welcome_text">Tämä on demo: kuviteltu yhdyskäytävä puhelimessasi, ja sen agentti on kesken työn. Tässä pikainen kierros ennen kuin yhdistät omasi.</string>
    <string name="app_tour_plan_title">Sen suunnitelma</string>
    <string name="app_tour_plan_text">Agenttisi pilkkoo työn vaiheisiin ja merkitsee ne tehdyiksi edetessään. Sen työskennellessä Keryx pitää työstä elävää ilmoitusta, joten voit laittaa puhelimen pois.</string>
    <string name="app_tour_approval_title">Se kysyy ensin</string>
    <string name="app_tour_approval_text">Ennen mitään riskialtista, kuten kansion poistamista, agenttisi pysähtyy ja kysyy. Vastaa täällä tai suoraan ilmoituksesta.</string>
    <string name="app_tour_approval_text_demo">Ennen mitään riskialtista, kuten kansion poistamista, agenttisi pysähtyy ja kysyy. Vastaa täällä tai suoraan ilmoituksesta. Kokeile sitä kierroksen jälkeen ja katso, kun se saa työn valmiiksi.</string>
    <string name="app_tour_composer_title">Pyydä mitä vain</string>
    <string name="app_tour_composer_text">Anna agentillesi työ omin sanoin. Se jatkaa työtä, vaikka poistuisit, ja Keryx kertoo, kun se on valmis.</string>
    <string name="app_tour_model_title">Mitkä aivot vastaavat</string>
    <string name="app_tour_model_text">Vaihda malli tälle istunnolle tai kaikille istunnoille tästä eteenpäin.</string>
    <string name="app_tour_new_session_title">Puhdas sivu</string>
    <string name="app_tour_new_session_text">Aloita uusi istunto. Pidä painettuna nähdäksesi valinnat, kuten otsikon tai väliaikaisen istunnon.</string>
    <string name="app_tour_drawer_title">Kaikki muu</string>
    <string name="app_tour_drawer_text">Istuntosi ja muu Keryx löytyvät tämän painikkeen takaa.</string>
    <string name="app_tour_lenses_title">Mikä tarvitsee sinua</string>
    <string name="app_tour_lenses_text">Rajaa lista istuntoihin, jotka odottavat sinua, ovat käynnissä juuri nyt tai ovat lukemattomia.</string>
    <string name="app_tour_missions_title">Tehtävät</string>
    <string name="app_tour_missions_text">Anna agentillesi pidempiä töitä kortteina taululla. Se käy ne läpi ja kysyy, kun tarvitsee sinua.</string>
    <string name="app_tour_runs_title">Ajot</string>
    <string name="app_tour_runs_text">Ajastetut työt ja mitä kukin ajo sai selville.</string>
    <string name="app_tour_bots_title">Botit</string>
    <string name="app_tour_bots_text">Agenttisi muut profiilit. Kullakin on oma muisti, taidot ja keskustelut.</string>
    <string name="app_tour_archive_title">Arkisto</string>
    <string name="app_tour_archive_text">Kaikki koskaan sanottu, haettavissa puhelimessa, vaikka yhdyskäytävä olisi alhaalla.</string>
    <string name="app_tour_gateway_title">Yhdyskäytäväsi</string>
    <string name="app_tour_gateway_text_demo">Omalla Hermesilläsi tässä näkyvät yhteys, malli ja versio. Kaikki juuri näkemäsi toimii samoin oikealla yhdyskäytävällä: yhdistä omasi, niin se on käytössä.</string>
    <string name="app_tour_gateway_text">Yhteys, malli ja Hermesin versio. Napauta avataksesi Yhdyskäytävän; ratas avaa Asetukset, josta löytyy myös tämä kierros.</string>
    <string name="app_tour_gateway_text_direct">Yhteys, malli ja Hermesin versio. Napauta avataksesi Yhdyskäytävän; ratas avaa Asetukset, josta löytyy myös tämä kierros. Onko sinulla useampi Hermes? Lisää se ja vaihda niiden välillä täällä.</string>
    <string name="app_tour_cta_connect">Yhdistä yhdyskäytäväsi</string>
    <string name="app_tour_cta_add_gateway">Lisää yhdyskäytävä</string>

    <string name="app_whatsnew_title">Uutta Keryx 3.0:ssa</string>
    <string name="app_whatsnew_text">Pikakatsaus muutoksiin. Voit ohittaa sen: se löytyy kohdasta Asetukset › Tietoja.</string>
    <string name="app_whatsnew_point_title">Kysy, missä jokin on</string>
    <string name="app_whatsnew_point_text">Kysy agentiltasi \"missä ajastetut työni ovat?\", niin se voi osoittaa paikan suoraan puhelimessa. Yhdyskäytäväsi tarvitsee keryx-stream 0.6:n tai uudemman.</string>
    <string name="app_whatsnew_memory_title">Keskustelun muisti</string>
    <string name="app_whatsnew_memory_text">Mallin vieressä oleva rengas kertoo nyt, montako vastausta tähän keskusteluun vielä mahtuu, ja vain silloin kun sillä on väliä. Napauta sitä nähdäksesi, mikä tilaa käyttää.</string>
    <string name="app_whatsnew_drawer_title">Uudistettu sivuvalikko</string>
    <string name="app_whatsnew_drawer_text_direct">Jokaisella keskustelulla on oma värinsä ja merkkinsä, rengas näyttää työssä olevat, ja nämä suodattimet rajaavat listan siihen, mikä tarvitsee sinua.</string>
    <string name="app_whatsnew_drawer_text">Jokaisella keskustelulla on oma värinsä ja merkkinsä, ja rengas näyttää työssä olevat.</string>
    <string name="app_whatsnew_cards_title">Kortit selkokielellä</string>
    <string name="app_whatsnew_cards_text">Tehtäväkortti avautuu nyt siihen, mitä on meneillään, ja yhteen seuraavaan asiaan. Tekniset tiedot ovat yhä tallella kohdassa Lisätiedot.</string>
    <string name="app_whatsnew_look_title">Ulkoasu ja päivitykset</string>
    <string name="app_whatsnew_look_text_direct">Kohdassa Asetukset › Ulkoasu on uusia ajattelutyylejä ja viisi tapaa siirtyä keskustelujen välillä. Tuoreella keryx-streamilla Yhdyskäytävän päivityspaneelista voi valita Stable- tai Edge-julkaisut. Lisätäksesi toisen Hermesin aja siinä hermes keryx pair ja skannaa koodi.</string>
    <string name="app_whatsnew_look_text">Kohdassa Asetukset › Ulkoasu on uusia ajattelutyylejä ja viisi tapaa siirtyä keskustelujen välillä. Kierros ja vinkit löytyvät kohdasta Asetukset › Tietoja.</string>

    <string name="app_hint_missions_title">Tehtävät</string>
    <string name="app_hint_missions_text">Pidemmät työt asuvat täällä kortteina. Agenttisi ottavat ne työn alle, ja sinua tarvitseva kortti nousee ylimmäksi. Jaa uusi napauttamalla +.</string>
    <string name="app_hint_runs_title">Ajot</string>
    <string name="app_hint_runs_text">Ajastetut työt, kuten aamukatsaus tai yöllinen tarkistus. Kunkin ajon tulos tulee tänne. Pyydä agenttiasi, niin se voi luoda sellaisen puolestasi.</string>
    <string name="app_hint_bots_title">Botit</string>
    <string name="app_hint_bots_text">Jokainen botti on Hermesisi profiili, jolla on oma muisti, taidot ja keskustelut. Avaa yksi jutellaksesi sen kanssa tai laita muutama ryhmäkeskusteluun.</string>
    <string name="app_hint_gateway_title">Yhdyskäytäväsi</string>
    <string name="app_hint_gateway_text">Miten yhdistetyllä Hermesilläsi menee ja mitä sen takana on: sen malli ja asetukset, työt, taidot, muisti ja työkalut.</string>
    <string name="app_hint_tapin_title">Tap-In</string>
    <string name="app_hint_tapin_text">Agenttisi työssä koko näytöllä: mitä se ajattelee, mitä työkaluja se ajaa ja mitä apureita se lähettää. Voit myös ohjata sitä täältä.</string>
    <string name="app_hint_artifact_title">Agenttisi tekemä sivu</string>
    <string name="app_hint_artifact_text">Agenttisi kirjoittamat raportit, luonnokset ja sivut avautuvat tänne, puhelimeen. Tallenna tai jaa yläreunan painikkeilla.</string>

