    <string name="chat_tokens_k">%1$dk tok</string>
    <!-- Files written by a subagent. -->
    <plurals name="chat_files_written">
        <item quantity="one">%d escrito</item>
        <item quantity="other">%d escritos</item>
    </plurals>
    <string name="chat_interrupted">interrumpido</string>
    <!-- Compact duration, e.g. 1m5s. -->
    <string name="chat_duration_min_sec_compact">%1$dm%2$ds</string>

    <!-- Flight plan strip: the agent's step list -->
    <!-- Header in capitals: the agent's list of steps. -->
    <string name="chat_flight_plan">PLAN DE VUELO</string>
    <string name="chat_flight_all_done">todos los pasos completados</string>
    <!-- %1$s is the next step. -->
    <string name="chat_flight_next">siguiente: %1$s</string>
    <!-- Keep both address formats exactly as they are; translate only 'or'. -->
    <string name="chat_join_sub">#alias:server o !roomid:server</string>
</resources>
