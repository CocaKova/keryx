    <string name="app_tour_approval_text_demo">Antes de algo arriesgado, como borrar una carpeta, tu agente se detiene y pregunta. Responde aquí o desde la notificación. Pruébalo cuando acabe el recorrido y míralo terminar el trabajo.</string>
    <string name="app_tour_composer_title">Pide lo que quieras</string>
    <string name="app_tour_composer_text">Dale un trabajo a tu agente con palabras sencillas. Sigue trabajando si te vas, y Keryx te avisa cuando termina.</string>
    <!-- "Brain" = the AI model. -->
    <string name="app_tour_model_title">Qué cerebro responde</string>
    <string name="app_tour_model_text">Cambia el modelo para esta sesión o para todas las sesiones a partir de ahora.</string>
    <string name="app_tour_new_session_title">Una página en blanco</string>
    <string name="app_tour_new_session_text">Inicia una sesión nueva. Mantén pulsado para ver opciones, como un título o una sesión temporal.</string>
    <string name="app_tour_drawer_title">Todo lo demás</string>
    <string name="app_tour_drawer_text">Tus sesiones y el resto de Keryx están detrás de este botón.</string>
    <string name="app_tour_lenses_title">Lo que te necesita</string>
    <string name="app_tour_lenses_text">Filtra la lista a sesiones que te esperan, en curso o sin leer.</string>
    <!-- Name of a place in the app: a board of longer jobs. -->
    <string name="app_tour_missions_title">Misiones</string>
    <string name="app_tour_missions_text">Encarga trabajos más largos a tu agente como tarjetas en un tablero. Los irá resolviendo y te preguntará cuando te necesite.</string>
    <!-- Name of a place in the app: scheduled jobs. -->
    <string name="app_tour_runs_title">Ejecuciones</string>
    <string name="app_tour_runs_text">Trabajos programados y lo que encontró cada ejecución.</string>
    <!-- Name of a place in the app: the agent's profiles. -->
    <string name="app_tour_bots_title">Bots</string>
    <string name="app_tour_bots_text">Los otros perfiles de tu agente. Cada uno tiene su propia memoria, habilidades y chats.</string>
    <!-- Name of a place in the app: the searchable history. -->
    <string name="app_tour_archive_title">Archivo</string>
    <string name="app_tour_archive_text">Todo lo que se ha dicho, con búsqueda en el teléfono, incluso con la pasarela caída.</string>
    <!-- The gateway is the Hermes server the app talks to. -->
    <string name="app_tour_gateway_title">Tu pasarela</string>
    <string name="app_tour_gateway_text_demo">Con tu propio Hermes, aquí verás la conexión, el modelo y la versión. Todo lo que acabas de ver funciona igual en una pasarela real: conecta la tuya y estará en marcha.</string>
    <string name="app_tour_gateway_text">La conexión, el modelo y la versión de Hermes. Tócalo para ir a la Pasarela; el engranaje abre Ajustes, donde también está este recorrido.</string>
    <string name="app_tour_gateway_text_direct">La conexión, el modelo y la versión de Hermes. Tócalo para ir a la Pasarela; el engranaje abre Ajustes, donde también está este recorrido. ¿Tienes más de un Hermes? Añádelo y cambia entre ellos aquí.</string>
    <!-- Button ending the demo's tour. -->
    <string name="app_tour_cta_connect">Conectar tu pasarela</string>
    <!-- Button ending the tour. -->
    <string name="app_tour_cta_add_gateway">Añadir una pasarela</string>

    <!-- What's new in 3.0 (a short tour shown once after updating) -->
    <string name="app_whatsnew_title">Novedades de Keryx 3.0</string>
    <string name="app_whatsnew_text">Un vistazo rápido a lo que cambió. Sáltalo si quieres: sigue en Ajustes › Acerca de.</string>
    <string name="app_whatsnew_point_title">Pregunta dónde está algo</string>
    <!-- Keep "keryx-stream 0.6" as is (a plugin name and version). -->
    <string name="app_whatsnew_point_text">Pregúntale a tu agente \"¿dónde están mis trabajos programados?\" y te puede señalar el lugar, aquí mismo en el teléfono. Tu pasarela necesita keryx-stream 0.6 o posterior.</string>
    <string name="app_whatsnew_memory_title">Memoria del chat</string>
    <string name="app_whatsnew_memory_text">El anillo junto al modelo ahora indica cuántas respuestas más caben en este chat, y solo cuando importa. Tócalo para ver qué ocupa el espacio.</string>
    <!-- The drawer = the side menu. -->
    <string name="app_whatsnew_drawer_title">Un menú lateral renovado</string>
    <string name="app_whatsnew_drawer_text_direct">Cada chat tiene su propio color y marca, un anillo muestra los que están trabajando y estos filtros reducen la lista a lo que te necesita.</string>
    <string name="app_whatsnew_drawer_text">Cada chat tiene su propio color y marca, y un anillo muestra los que están trabajando.</string>
    <string name="app_whatsnew_cards_title">Tarjetas en palabras sencillas</string>
    <!-- "Details" names a section on the card. -->
    <string name="app_whatsnew_cards_text">Una tarjeta de misión ahora se abre con lo que está pasando y lo siguiente que hay que hacer. Los detalles técnicos siguen ahí, en Detalles.</string>
    <string name="app_whatsnew_look_title">Aspecto y actualizaciones</string>
    <!-- Keep "keryx-stream" and the command "hermes keryx pair" as is. "Stable" and "Edge" are release channel names. -->
    <string name="app_whatsnew_look_text_direct">Ajustes › Apariencia tiene nuevos estilos de razonamiento y cinco formas de pasar de un chat a otro. Con un keryx-stream reciente, el panel Actualizar de la Pasarela te deja elegir versiones Stable o Edge. Para añadir otro Hermes, ejecuta hermes keryx pair en él y escanea el código.</string>
    <string name="app_whatsnew_look_text">Ajustes › Apariencia tiene nuevos estilos de razonamiento y cinco formas de pasar de un chat a otro. El recorrido y las pistas de cada sección están en Ajustes › Acerca de.</string>
    <string name="app_whatsnew_more_text">Los espacios recuerdan dónde estabas y una etiqueta te devuelve tras un desvío. Bloquea una habilidad para que tu agente no pueda cambiarla. Los modos claro y oscuro guardan sus propios colores.</string>
    <string name="app_whatsnew_more_title">Pequeños detalles</string>
    <string name="app_whatsnew_board_text">Las tarjetas ahora están en columnas que recorres deslizando, y puedes tener más de un tablero.</string>
    <string name="app_whatsnew_board_title">Misiones en un tablero</string>
    <string name="app_tour_bot_lights_text">Toca un bot para abrir su chat o mantenlo pulsado para gestionarlo. Un anillo que respira indica que está trabajando.</string>
    <string name="app_tour_bot_lights_title">Tus bots</string>

    <!-- First-visit hints: one card the first time a place opens -->
    <string name="app_hint_missions_title">Misiones</string>
    <string name="app_hint_missions_text">Aquí viven los trabajos más largos, como tarjetas. Tus agentes los toman y los resuelven, y una tarjeta que te necesita sube arriba. Toca + para encargar una.</string>
    <string name="app_hint_runs_title">Ejecuciones</string>
    <string name="app_hint_runs_text">Trabajos programados, como un resumen matutino o una revisión nocturna. El resultado de cada ejecución llega aquí. Pídeselo a tu agente y puede configurarte uno.</string>
    <string name="app_hint_bots_title">Bots</string>
    <string name="app_hint_bots_text">Cada bot es un perfil de tu Hermes, con su propia memoria, habilidades y chats. Abre uno para hablarle o junta varios en un chat de grupo.</string>
    <string name="app_hint_gateway_title">Tu pasarela</string>
    <string name="app_hint_gateway_text">Cómo está el Hermes al que estás conectado y qué hay detrás: su modelo y ajustes, trabajos, habilidades, memoria y herramientas.</string>
    <!-- Name of a full-screen view of the agent at work. -->
    <string name="app_hint_tapin_title">Tap-In</string>
    <string name="app_hint_tapin_text">Tu agente trabajando, a pantalla completa: lo que piensa, las herramientas que usa y los ayudantes que envía. También puedes guiarlo desde aquí.</string>
    <string name="app_hint_artifact_title">Una página que hizo tu agente</string>
    <string name="app_hint_artifact_text">Los informes, maquetas y páginas que escribe tu agente se abren aquí, en el teléfono. Guarda uno o compártelo con los botones de arriba.</string>

    <!-- The tour's card -->
    <!-- Accessibility: the name of the tour's card. -->
    <string name="app_tour_pane">Recorrido</string>
    <!-- Accessibility label of the card's close button. -->
    <string name="app_tour_end">Terminar el recorrido</string>
    <!-- Which stop of the tour this is, e.g. "3 of 12". -->
    <string name="app_tour_progress">%1$d de %2$d</string>
    <!-- Button: the previous tour stop. -->
    <string name="app_tour_back">Atrás</string>
    <!-- Button: end the tour. -->
    <string name="app_tour_done">Listo</string>
    <!-- Button: dismiss a one-off hint. -->
    <string name="app_tour_got_it">Entendido</string>
    <!-- Button: the next tour stop. -->
    <string name="app_tour_next">Siguiente</string>
</resources>
