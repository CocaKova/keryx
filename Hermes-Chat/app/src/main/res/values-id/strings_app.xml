    <string name="app_tour_welcome_title">Selamat datang di Keryx</string>
    <string name="app_tour_welcome_text">Ini demo: gateway pura-pura di ponselmu, dan agennya sedang mengerjakan sesuatu. Mari lihat-lihat sebentar sebelum kamu menghubungkan milikmu sendiri.</string>
    <string name="app_tour_plan_title">Rencananya</string>
    <string name="app_tour_plan_text">Agenmu memecah pekerjaan jadi langkah-langkah dan mencentangnya satu per satu. Selama bekerja, Keryx menampilkan notifikasi langsung, jadi ponselmu bisa disimpan.</string>
    <string name="app_tour_approval_title">Bertanya dulu</string>
    <string name="app_tour_approval_text">Sebelum melakukan hal berisiko, seperti menghapus folder, agenmu berhenti dan bertanya. Jawab di sini atau langsung dari notifikasi.</string>
    <string name="app_tour_approval_text_demo">Sebelum melakukan hal berisiko, seperti menghapus folder, agenmu berhenti dan bertanya. Jawab di sini atau langsung dari notifikasi. Coba setelah tur selesai, dan lihat ia menuntaskan pekerjaannya.</string>
    <string name="app_tour_composer_title">Minta apa saja</string>
    <string name="app_tour_composer_text">Beri agenmu pekerjaan dengan kata-kata biasa. Ia tetap bekerja meski kamu pergi, dan Keryx memberi tahu saat selesai.</string>
    <string name="app_tour_model_title">Otak mana yang menjawab</string>
    <string name="app_tour_model_text">Ganti model untuk sesi ini, atau untuk semua sesi mulai sekarang.</string>
    <string name="app_tour_new_session_title">Halaman baru</string>
    <string name="app_tour_new_session_text">Mulai sesi baru. Tahan untuk opsi, seperti judul atau sesi sementara.</string>
    <string name="app_tour_drawer_title">Semua yang lain</string>
    <string name="app_tour_drawer_text">Sesi-sesimu dan bagian Keryx lainnya ada di balik tombol ini.</string>
    <string name="app_tour_lenses_title">Yang menunggumu</string>
    <string name="app_tour_lenses_text">Persempit daftar ke sesi yang menunggumu, yang sedang berjalan, atau yang belum dibaca.</string>
    <string name="app_tour_missions_title">Misi</string>
    <string name="app_tour_missions_text">Serahkan pekerjaan panjang ke agenmu sebagai kartu di papan. Ia mengerjakannya dan bertanya saat membutuhkanmu.</string>
    <string name="app_tour_runs_title">Eksekusi</string>
    <string name="app_tour_runs_text">Tugas terjadwal, dan hasil setiap eksekusinya.</string>
    <string name="app_tour_bots_title">Bot</string>
    <string name="app_tour_bots_text">Profil lain dari agenmu. Masing-masing punya memori, keahlian, dan obrolan sendiri.</string>
    <string name="app_tour_archive_title">Arsip</string>
    <string name="app_tour_archive_text">Semua yang pernah diucapkan, bisa dicari di ponsel, bahkan saat gateway mati.</string>
    <string name="app_tour_gateway_title">Gateway-mu</string>
    <string name="app_tour_gateway_text_demo">Dengan Hermes milikmu sendiri, di sini tampil koneksi, model, dan versinya. Semua yang baru kamu lihat bekerja sama persis di gateway sungguhan: hubungkan milikmu dan langsung aktif.</string>
    <string name="app_tour_gateway_text">Koneksi, model, dan versi Hermes. Ketuk untuk Gateway; ikon roda gigi membuka Setelan, tempat tur ini juga berada.</string>
    <string name="app_tour_gateway_text_direct">Koneksi, model, dan versi Hermes. Ketuk untuk Gateway; ikon roda gigi membuka Setelan, tempat tur ini juga berada. Punya lebih dari satu Hermes? Tambahkan dan beralih di antaranya di sini.</string>
    <string name="app_tour_cta_connect">Hubungkan gateway-mu</string>
    <string name="app_tour_cta_add_gateway">Tambah gateway</string>

    <string name="app_whatsnew_title">Yang baru di Keryx 3.0</string>
    <string name="app_whatsnew_text">Sekilas tentang yang berubah. Lewati saja kalau mau: tetap ada di Setelan › Tentang.</string>
    <string name="app_whatsnew_point_title">Tanya letak sesuatu</string>
    <string name="app_whatsnew_point_text">Tanya agenmu \"di mana tugas terjadwalku?\" dan ia bisa menunjukkan tempatnya, langsung di ponsel. Gateway-mu butuh keryx-stream 0.6 atau yang lebih baru.</string>
    <string name="app_whatsnew_memory_title">Memori obrolan</string>
    <string name="app_whatsnew_memory_text">Cincin di samping model kini menunjukkan berapa balasan lagi yang muat di obrolan ini, dan hanya saat itu penting. Ketuk untuk melihat apa yang memakai ruangnya.</string>
    <string name="app_whatsnew_drawer_title">Menu samping yang digambar ulang</string>
    <string name="app_whatsnew_drawer_text_direct">Setiap obrolan punya warna dan tanda sendiri, cincin menandai yang sedang bekerja, dan filter ini mempersempit daftar ke yang menunggumu.</string>
    <string name="app_whatsnew_drawer_text">Setiap obrolan punya warna dan tanda sendiri, dan cincin menandai yang sedang bekerja.</string>
    <string name="app_whatsnew_cards_title">Kartu dengan bahasa sederhana</string>
    <string name="app_whatsnew_cards_text">Kartu misi kini terbuka dengan apa yang sedang terjadi dan satu hal yang perlu dilakukan berikutnya. Detail teknisnya tetap ada, di bawah Detail.</string>
    <string name="app_whatsnew_look_title">Tampilan dan pembaruan</string>
    <string name="app_whatsnew_look_text_direct">Setelan › Tampilan punya gaya berpikir baru dan lima cara berpindah antarobrolan. Dengan keryx-stream terbaru, panel Pembaruan di Gateway memungkinkanmu memilih rilis Stabil atau Edge. Untuk menambah Hermes lain, jalankan hermes keryx pair di sana lalu pindai kodenya.</string>
    <string name="app_whatsnew_look_text">Setelan › Tampilan punya gaya berpikir baru dan lima cara berpindah antarobrolan. Tur dan petunjuk ruang ada di Setelan › Tentang.</string>

    <string name="app_hint_missions_title">Misi</string>
    <string name="app_hint_missions_text">Pekerjaan panjang ada di sini sebagai kartu. Agenmu mengambil dan mengerjakannya, dan kartu yang membutuhkanmu naik ke atas. Ketuk + untuk memberikan satu.</string>
    <string name="app_hint_runs_title">Eksekusi</string>
    <string name="app_hint_runs_text">Tugas terjadwal, seperti ringkasan pagi atau pemeriksaan malam. Hasil setiap eksekusi masuk ke sini. Tanya agenmu dan ia bisa membuatkannya.</string>
    <string name="app_hint_bots_title">Bot</string>
    <string name="app_hint_bots_text">Setiap bot adalah profil Hermes-mu, dengan memori, keahlian, dan obrolan sendiri. Buka satu untuk bicara dengannya, atau masukkan beberapa ke obrolan grup.</string>
    <string name="app_hint_gateway_title">Gateway-mu</string>
    <string name="app_hint_gateway_text">Kondisi Hermes yang terhubung denganmu, dan apa di baliknya: model dan setelannya, tugas, keahlian, memori, dan alat.</string>
    <string name="app_hint_tapin_title">Tap-In</string>
    <string name="app_hint_tapin_text">Agenmu saat bekerja, layar penuh: apa yang dipikirkannya, alat yang dijalankannya, dan pembantu yang dikirimnya. Kamu juga bisa mengarahkannya dari sini.</string>
