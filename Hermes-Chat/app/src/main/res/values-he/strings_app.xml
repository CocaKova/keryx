    <string name="app_tour_welcome_text">זו הדגמה: שער מדומה בטלפון שלך, והסוכן שלו באמצע עבודה. הנה סיור קצר לפני שמחברים את השער שלך.</string>
    <string name="app_tour_plan_title">התוכנית שלו</string>
    <string name="app_tour_plan_text">הסוכן שלך מפרק עבודה לצעדים ומסמן אותם תוך כדי. בזמן שהוא עובד, Keryx מציג התראה חיה על העבודה, כך שאפשר להניח את הטלפון בצד.</string>
    <string name="app_tour_approval_title">הוא שואל קודם</string>
    <string name="app_tour_approval_text">לפני כל דבר מסוכן, כמו מחיקת תיקייה, הסוכן שלך עוצר ושואל. אפשר לענות כאן או ישירות מההתראה.</string>
    <string name="app_tour_approval_text_demo">לפני כל דבר מסוכן, כמו מחיקת תיקייה, הסוכן שלך עוצר ושואל. אפשר לענות כאן או ישירות מההתראה. כדאי לנסות כשהסיור נגמר, ולראות אותו מסיים את העבודה.</string>
    <string name="app_tour_composer_title">אפשר לבקש כל דבר</string>
    <string name="app_tour_composer_text">אפשר לתת לסוכן עבודה במילים פשוטות. הוא ממשיך לעבוד גם אם יוצאים, ו־Keryx מודיע כשהוא מסיים.</string>
    <string name="app_tour_model_title">איזה מוח עונה</string>
    <string name="app_tour_model_text">החלפת המודל לסשן הזה, או לכל הסשנים מעכשיו והלאה.</string>
    <string name="app_tour_new_session_title">דף חדש</string>
    <string name="app_tour_new_session_text">התחלת סשן חדש. לחיצה ארוכה פותחת אפשרויות, כמו כותרת או סשן זמני.</string>
    <string name="app_tour_drawer_title">כל השאר</string>
    <string name="app_tour_drawer_text">הסשנים שלך וכל שאר Keryx נמצאים מאחורי הכפתור הזה.</string>
    <string name="app_tour_lenses_title">מה מחכה לך</string>
    <string name="app_tour_lenses_text">צמצום הרשימה לסשנים שמחכים לך, שרצים עכשיו או שלא נקראו.</string>
    <string name="app_tour_missions_title">משימות</string>
    <string name="app_tour_missions_text">אפשר למסור לסוכן עבודות ארוכות יותר ככרטיסים על לוח. הוא עובד עליהן ושואל כשהוא צריך אותך.</string>
    <string name="app_tour_runs_title">הרצות</string>
    <string name="app_tour_runs_text">עבודות מתוזמנות, ומה שכל הרצה העלתה.</string>
    <string name="app_tour_bots_title">בוטים</string>
    <string name="app_tour_bots_text">הפרופילים האחרים של הסוכן שלך. לכל אחד זיכרון, מיומנויות ושיחות משלו.</string>
    <string name="app_tour_archive_title">ארכיון</string>
    <string name="app_tour_archive_text">כל מה שנאמר אי פעם, עם חיפוש בטלפון, גם כשהשער למטה.</string>
    <string name="app_tour_gateway_title">השער שלך</string>
    <string name="app_tour_gateway_text_demo">עם Hermes משלך, כאן יוצגו החיבור, המודל והגרסה. כל מה שראית עכשיו עובד אותו דבר בשער אמיתי: מחברים את שלך והוא פעיל.</string>
    <string name="app_tour_gateway_text">החיבור, המודל וגרסת Hermes. הקשה כאן פותחת את השער; גלגל השיניים פותח את ההגדרות, ושם נמצא גם הסיור הזה.</string>
    <string name="app_tour_gateway_text_direct">החיבור, המודל וגרסת Hermes. הקשה כאן פותחת את השער; גלגל השיניים פותח את ההגדרות, ושם נמצא גם הסיור הזה. יש לך יותר מ־Hermes אחד? אפשר להוסיף אותו ולעבור ביניהם מכאן.</string>
    <string name="app_tour_cta_connect">חיבור השער שלך</string>
    <string name="app_tour_cta_add_gateway">הוספת שער</string>

    <string name="app_whatsnew_title">מה חדש ב־Keryx 3.0</string>
    <string name="app_whatsnew_text">מבט קצר על מה שהשתנה. אפשר לדלג: זה נשאר בהגדרות › מידע.</string>
    <string name="app_whatsnew_point_title">לשאול איפה משהו נמצא</string>
    <string name="app_whatsnew_point_text">אפשר לשאול את הסוכן \"איפה העבודות המתוזמנות שלי?\" והוא יכול להצביע על המקום, כאן בטלפון. השער שלך צריך keryx-stream 0.6 ומעלה.</string>
    <string name="app_whatsnew_memory_title">זיכרון השיחה</string>
    <string name="app_whatsnew_memory_text">הטבעת שליד המודל מראה עכשיו לכמה תשובות נוספות יש מקום בשיחה, ורק כשזה משנה. הקשה עליה מראה מה תופס את המקום.</string>
    <string name="app_whatsnew_drawer_title">מגירה מעוצבת מחדש</string>
    <string name="app_whatsnew_drawer_text_direct">לכל שיחה צבע וסימן משלה, טבעת מראה את אלה שבעבודה, והמסננים האלה מצמצמים את הרשימה למה שמחכה לך.</string>
    <string name="app_whatsnew_drawer_text">לכל שיחה צבע וסימן משלה, וטבעת מראה את אלה שבעבודה.</string>
    <string name="app_whatsnew_cards_title">כרטיסים במילים פשוטות</string>
    <string name="app_whatsnew_cards_text">כרטיס משימה נפתח עכשיו על מה שקורה ועל הדבר האחד שצריך לעשות הלאה. הפרטים הטכניים עדיין שם, תחת פרטים.</string>
    <string name="app_whatsnew_look_title">מראה ועדכונים</string>
    <string name="app_whatsnew_look_text_direct">בהגדרות › מראה יש סגנונות חשיבה חדשים וחמש דרכים לעבור בין שיחות. עם keryx-stream עדכני, לוח העדכון של השער מאפשר לבחור גרסאות Stable או Edge. כדי להוסיף Hermes נוסף, מריצים עליו hermes keryx pair וסורקים את הקוד.</string>
    <string name="app_whatsnew_look_text">בהגדרות › מראה יש סגנונות חשיבה חדשים וחמש דרכים לעבור בין שיחות. הסיור וההסברים על כל אזור נמצאים בהגדרות › מידע.</string>
    <string name="app_whatsnew_more_text">המקומות זוכרים איפה הייתם, ושבב קטן מחזיר אתכם אחרי עיקוף. נעלו מיומנות כדי שהסוכן לא יוכל לשנות אותה. למצב בהיר ולמצב כהה יש צבעים משלהם.</string>
    <string name="app_whatsnew_more_title">דברים קטנים</string>
    <string name="app_whatsnew_board_text">הכרטיסים יושבים עכשיו בטורים שעוברים ביניהם בהחלקה, ואפשר להחזיק יותר מלוח אחד.</string>
    <string name="app_whatsnew_board_title">משימות על לוח</string>
    <string name="app_tour_bot_lights_text">הקישו על בוט כדי לפתוח את הצ\'אט שלו, או לחצו עליו לחיצה ארוכה כדי לנהל אותו. טבעת נושמת אומרת שהוא עובד.</string>
    <string name="app_tour_bot_lights_title">הבוטים שלך</string>

    <string name="app_hint_missions_title">משימות</string>
    <string name="app_hint_missions_text">עבודות ארוכות יותר נמצאות כאן ככרטיסים. הסוכנים שלך לוקחים אותן ועובדים עליהן, וכרטיס שצריך אותך עולה לראש. הקשה על + מוסרת משימה.</string>
    <string name="app_hint_runs_title">הרצות</string>
    <string name="app_hint_runs_text">עבודות לפי לוח זמנים, כמו תדריך בוקר או בדיקה לילית. התוצאה של כל הרצה מגיעה לכאן. אפשר לבקש מהסוכן והוא יגדיר אחת בשבילך.</string>
    <string name="app_hint_bots_title">בוטים</string>
    <string name="app_hint_bots_text">כל בוט הוא פרופיל של Hermes שלך, עם זיכרון, מיומנויות ושיחות משלו. אפשר לפתוח אחד כדי לדבר איתו, או לשים כמה בשיחה קבוצתית.</string>
    <string name="app_hint_gateway_title">השער שלך</string>
    <string name="app_hint_gateway_text">מה מצבו של Hermes שאליו התחברת, ומה מאחוריו: המודל וההגדרות, העבודות, המיומנויות, הזיכרון והכלים.</string>
    <string name="app_hint_tapin_title">Tap-In</string>
    <string name="app_hint_tapin_text">הסוכן שלך בעבודה, במסך מלא: על מה הוא חושב, אילו כלים הוא מריץ ואילו עוזרים הוא שולח. אפשר גם להכווין אותו מכאן.</string>
    <string name="app_hint_artifact_title">דף שהסוכן שלך יצר</string>
    <string name="app_hint_artifact_text">דוחות, הדמיות ודפים שהסוכן כותב נפתחים כאן, בטלפון. אפשר לשמור או לשתף בעזרת הכפתורים למעלה.</string>

