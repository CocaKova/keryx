    <string name="app_tour_welcome_title">Velkommen til Keryx</string>
    <string name="app_tour_welcome_text">Dette er en demo: en lege-gateway på din telefon, og dens agent er midt i en opgave. Her er en hurtig rundvisning, før du forbinder din egen.</string>
    <string name="app_tour_plan_title">Dens plan</string>
    <string name="app_tour_plan_text">Din agent deler en opgave op i skridt og krydser dem af undervejs. Mens den arbejder, viser Keryx en løbende notifikation om opgaven, så du kan lægge telefonen væk.</string>
    <string name="app_tour_approval_title">Den spørger først</string>
    <string name="app_tour_approval_text">Før noget risikabelt, som at slette en mappe, stopper din agent og spørger. Svar her eller direkte fra notifikationen.</string>
    <string name="app_tour_approval_text_demo">Før noget risikabelt, som at slette en mappe, stopper din agent og spørger. Svar her eller direkte fra notifikationen. Prøv det, når rundvisningen er slut, og se den gøre opgaven færdig.</string>
    <string name="app_tour_composer_title">Spørg om hvad som helst</string>
    <string name="app_tour_composer_text">Giv din agent en opgave med almindelige ord. Den arbejder videre, hvis du går, og Keryx giver dig besked, når den er færdig.</string>
    <string name="app_tour_model_title">Hvilken hjerne der svarer</string>
    <string name="app_tour_model_text">Skift model for denne session eller for alle sessioner fremover.</string>
    <string name="app_tour_new_session_title">En frisk side</string>
    <string name="app_tour_new_session_text">Start en ny session. Hold fingeren på knappen for flere valg, som en titel eller en midlertidig session.</string>
    <string name="app_tour_drawer_title">Alt det andet</string>
    <string name="app_tour_drawer_text">Dine sessioner og resten af Keryx ligger bag denne knap.</string>
    <string name="app_tour_lenses_title">Hvad der venter på dig</string>
    <string name="app_tour_lenses_text">Snævr listen ind til sessioner, der venter på dig, kører lige nu eller er ulæste.</string>
    <string name="app_tour_missions_title">Missioner</string>
    <string name="app_tour_missions_text">Giv din agent længere opgaver som kort på en tavle. Den arbejder sig igennem dem og spørger, når den har brug for dig.</string>
    <string name="app_tour_runs_title">Kørsler</string>
    <string name="app_tour_runs_text">Planlagte opgaver, og hvad hver kørsel fandt.</string>
    <string name="app_tour_bots_title">Bots</string>
    <string name="app_tour_bots_text">Din agents andre profiler. Hver har sin egen hukommelse, færdigheder og chats.</string>
    <string name="app_tour_archive_title">Arkiv</string>
    <string name="app_tour_archive_text">Alt, der nogensinde er sagt, søgbart på telefonen, selv når gatewayen er nede.</string>
    <string name="app_tour_gateway_title">Din gateway</string>
    <string name="app_tour_gateway_text_demo">Med din egen Hermes viser dette forbindelsen, modellen og versionen. Alt, hvad du lige har set, virker på samme måde på en rigtig gateway: forbind din, så er den live.</string>
    <string name="app_tour_gateway_text">Forbindelsen, modellen og Hermes-versionen. Tryk for at åbne Gateway; tandhjulet åbner Indstillinger, hvor denne rundvisning også bor.</string>
    <string name="app_tour_gateway_text_direct">Forbindelsen, modellen og Hermes-versionen. Tryk for at åbne Gateway; tandhjulet åbner Indstillinger, hvor denne rundvisning også bor. Kører du mere end én Hermes? Tilføj den, og skift mellem dem her.</string>
    <string name="app_tour_cta_connect">Forbind din gateway</string>
    <string name="app_tour_cta_add_gateway">Tilføj en gateway</string>

    <string name="app_whatsnew_title">Nyt i Keryx 3.0</string>
    <string name="app_whatsnew_text">Et hurtigt kig på, hvad der er ændret. Spring over, hvis du vil: det ligger også i Indstillinger › Om.</string>
    <string name="app_whatsnew_point_title">Spørg, hvor noget er</string>
    <string name="app_whatsnew_point_text">Spørg din agent »hvor er mine planlagte opgaver?«, så kan den pege på stedet, lige her på telefonen. Din gateway skal have keryx-stream 0.6 eller nyere.</string>
    <string name="app_whatsnew_memory_title">Chathukommelse</string>
    <string name="app_whatsnew_memory_text">Ringen ved siden af modellen viser nu, hvor mange svar der er plads til i denne chat, og kun når det betyder noget. Tryk på den for at se, hvad der bruger pladsen.</string>
    <string name="app_whatsnew_drawer_title">En ny sidemenu</string>
    <string name="app_whatsnew_drawer_text_direct">Hver chat har sin egen farve og sit eget mærke, en ring viser dem, der arbejder, og disse filtre snævrer listen ind til det, der venter på dig.</string>
    <string name="app_whatsnew_drawer_text">Hver chat har sin egen farve og sit eget mærke, og en ring viser dem, der arbejder.</string>
    <string name="app_whatsnew_cards_title">Kort i almindelige ord</string>
    <string name="app_whatsnew_cards_text">Et missionskort åbner nu med, hvad der sker, og den ene ting, der skal gøres som det næste. De tekniske detaljer er der stadig under Detaljer.</string>
    <string name="app_whatsnew_look_title">Udseende og opdateringer</string>
    <string name="app_whatsnew_look_text_direct">Indstillinger › Udseende har nye tænkestile og fem måder at skifte mellem chats på. Med en nyere keryx-stream kan du i Gatewayens Opdater-panel vælge Stabil eller Edge. For at tilføje en anden Hermes skal du køre hermes keryx pair på den og scanne koden.</string>
    <string name="app_whatsnew_look_text">Indstillinger › Udseende har nye tænkestile og fem måder at skifte mellem chats på. Rundvisningen og tipsene til hvert område ligger i Indstillinger › Om.</string>

    <string name="app_hint_missions_title">Missioner</string>
    <string name="app_hint_missions_text">Længere opgaver ligger her som kort. Dine agenter tager dem og arbejder sig igennem dem, og et kort, der har brug for dig, ryger øverst. Tryk på + for at uddele et.</string>
    <string name="app_hint_runs_title">Kørsler</string>
    <string name="app_hint_runs_text">Opgaver efter en tidsplan, som en morgenbriefing eller et natligt tjek. Resultatet af hver kørsel lander her. Spørg din agent, så kan den sætte en op for dig.</string>
    <string name="app_hint_bots_title">Bots</string>
    <string name="app_hint_bots_text">Hver bot er en profil i din Hermes med sin egen hukommelse, færdigheder og chats. Åbn en for at tale med den, eller saml et par stykker i en gruppechat.</string>
    <string name="app_hint_gateway_title">Din gateway</string>
    <string name="app_hint_gateway_text">Hvordan det går med den Hermes, du er forbundet til, og hvad der ligger bag: dens model og indstillinger, opgaver, færdigheder, hukommelse og værktøjer.</string>
    <string name="app_hint_tapin_title">Tap-In</string>
    <string name="app_hint_tapin_text">Din agent i arbejde, i fuld skærm: hvad den tænker, de værktøjer den kører, og de hjælpere den sender ud. Du kan også styre den herfra.</string>
    <string name="app_hint_artifact_title">En side, din agent har lavet</string>
    <string name="app_hint_artifact_text">Rapporter, mock-ups og sider, som din agent skriver, åbner her på telefonen. Gem eller del dem med knapperne øverst.</string>

    <string name="app_tour_pane">Rundvisning</string>
    <string name="app_tour_end">Afslut rundvisningen</string>
