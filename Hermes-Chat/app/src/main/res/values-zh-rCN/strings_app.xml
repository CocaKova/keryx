    <string name="app_tour_welcome_title">欢迎使用 Keryx</string>
    <string name="app_tour_welcome_text">这是一个演示：你手机上有一个模拟网关，它的智能体正在执行任务。连接你自己的网关之前，先快速看一圈吧。</string>
    <string name="app_tour_plan_title">它的计划</string>
    <string name="app_tour_plan_text">智能体会把一项工作拆成步骤，边做边打勾。它工作时，Keryx 会持续显示进度通知，你可以放下手机。</string>
    <string name="app_tour_approval_title">先问再做</string>
    <string name="app_tour_approval_text">在做任何有风险的事（比如删除文件夹）之前，智能体会停下来问你。可以在这里回答，也可以直接在通知里回答。</string>
    <string name="app_tour_approval_text_demo">在做任何有风险的事（比如删除文件夹）之前，智能体会停下来问你。可以在这里回答，也可以直接在通知里回答。导览结束后试试看，然后看它完成工作。</string>
    <string name="app_tour_composer_title">尽管开口</string>
    <string name="app_tour_composer_text">用平常的话给智能体布置工作。你离开后它会继续工作，完成时 Keryx 会通知你。</string>
    <string name="app_tour_model_title">由哪个模型回答</string>
    <string name="app_tour_model_text">为此会话切换模型，或从现在起为所有会话切换。</string>
    <string name="app_tour_new_session_title">新的一页</string>
    <string name="app_tour_new_session_text">开始新会话。长按可查看更多选项，比如标题或临时会话。</string>
    <string name="app_tour_drawer_title">其他一切</string>
    <string name="app_tour_drawer_text">你的会话和 Keryx 的其他功能都在这个按钮后面。</string>
    <string name="app_tour_lenses_title">需要你处理的</string>
    <string name="app_tour_lenses_text">把列表筛选为等你处理、正在运行或未读的会话。</string>
    <string name="app_tour_missions_title">任务</string>
    <string name="app_tour_missions_text">以看板卡片的形式把较长的工作交给智能体。它会逐一处理，需要你时会来问你。</string>
    <string name="app_tour_runs_title">运行</string>
    <string name="app_tour_runs_text">定时作业，以及每次运行的结果。</string>
    <string name="app_tour_bots_title">机器人</string>
    <string name="app_tour_bots_text">你的智能体的其他配置档。每个都有自己的记忆、技能和聊天。</string>
    <string name="app_tour_archive_title">归档</string>
    <string name="app_tour_archive_text">说过的一切都在这里，可在手机上搜索，网关离线时也可以。</string>
    <string name="app_tour_gateway_title">你的网关</string>
    <string name="app_tour_gateway_text_demo">连接你自己的 Hermes 后，这里会显示连接、模型和版本。你刚才看到的一切在真实网关上都一样：连上你的网关就能用。</string>
    <string name="app_tour_gateway_text">连接、模型和 Hermes 版本。点按进入网关；齿轮打开设置，导览也在那里。</string>
    <string name="app_tour_gateway_text_direct">连接、模型和 Hermes 版本。点按进入网关；齿轮打开设置，导览也在那里。有不止一个 Hermes？添加后可在这里切换。</string>
    <string name="app_tour_cta_connect">连接你的网关</string>
    <string name="app_tour_cta_add_gateway">添加网关</string>

    <string name="app_whatsnew_title">Keryx 3.0 新功能</string>
    <string name="app_whatsnew_text">快速看看有哪些变化。也可以跳过：它一直在 设置 › 关于 中。</string>
    <string name="app_whatsnew_point_title">问问东西在哪</string>
    <string name="app_whatsnew_point_text">问智能体“我的定时作业在哪？”，它就能在手机上直接指给你看。你的网关需要 keryx-stream 0.6 或更新版本。</string>
    <string name="app_whatsnew_memory_title">聊天记忆</string>
    <string name="app_whatsnew_memory_text">模型旁边的圆环现在会显示此聊天还能容纳多少条回复，而且只在需要时显示。点按查看是什么在占用空间。</string>
    <string name="app_whatsnew_drawer_title">重新设计的侧边栏</string>
    <string name="app_whatsnew_drawer_text_direct">每个聊天都有自己的颜色和标记，圆环标出正在工作的聊天，这些筛选器可以把列表缩小到需要你处理的内容。</string>
    <string name="app_whatsnew_drawer_text">每个聊天都有自己的颜色和标记，圆环标出正在工作的聊天。</string>
    <string name="app_whatsnew_cards_title">通俗易懂的卡片</string>
    <string name="app_whatsnew_cards_text">任务卡片现在一打开就显示进展和下一步要做的事。技术细节仍在“详情”下面。</string>
    <string name="app_whatsnew_look_title">外观与更新</string>
    <string name="app_whatsnew_look_text_direct">设置 › 外观 里有新的思考样式，以及五种切换聊天的动画。使用较新的 keryx-stream 时，网关的“更新”面板可以选择 Stable 或 Edge 版本。要添加另一个 Hermes，请在它上面运行 hermes keryx pair 并扫描配对码。</string>
    <string name="app_whatsnew_look_text">设置 › 外观 里有新的思考样式，以及五种切换聊天的动画。导览和各处提示在 设置 › 关于 中。</string>

    <string name="app_hint_missions_title">任务</string>
    <string name="app_hint_missions_text">较长的工作以卡片形式放在这里。智能体会领取并逐一处理，需要你的卡片会移到最上面。点按 + 来分配一项。</string>
    <string name="app_hint_runs_title">运行</string>
    <string name="app_hint_runs_text">按计划执行的工作，比如晨间简报或夜间检查。每次运行的结果都会出现在这里。告诉智能体，它就能帮你设置一个。</string>
    <string name="app_hint_bots_title">机器人</string>
    <string name="app_hint_bots_text">每个机器人都是你的 Hermes 的一个配置档，有自己的记忆、技能和聊天。打开一个与它对话，或把几个放进群聊。</string>
    <string name="app_hint_gateway_title">你的网关</string>
    <string name="app_hint_gateway_text">你连接的 Hermes 运行状况如何，以及它背后有什么：模型和设置、工作、技能、记忆和工具。</string>
    <string name="app_hint_tapin_title">Tap-In</string>
    <string name="app_hint_tapin_text">全屏查看智能体工作：它在想什么、运行了哪些工具、派出了哪些助手。你也可以在这里引导它。</string>
    <string name="app_hint_artifact_title">智能体制作的页面</string>
    <string name="app_hint_artifact_text">智能体写的报告、草图和页面会在手机上的这里打开。用顶部的按钮保存或分享。</string>

