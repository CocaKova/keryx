# Gradle
.gradle/
build/
**/build/

# The Gradle wrapper jar IS committed — it is 54 KB and it is the only reason `./gradlew`
# works on a machine that has never seen this project. Ignoring it (a misapplied "no binaries"
# rule) made a fresh clone of a public repo unbuildable.

# Local config (generated by Android Studio)
local.properties

# IDE
.idea/
*.iml
.vscode/

# Kotlin
.kotlin/

# OS
.DS_Store
Thumbs.db

# Local-only cruft
backups/
Hermes-Chat/jdk.tar.gz

# Build output. keryx-2.1.1.apk predates this line and stays tracked; releases ship from
# GitHub Releases, not from the working tree, and three test builds went in by accident once.
*.apk

# Python bytecode. One .pyc went in by accident and was carried for months;
# running tools/launcher_icon.py regenerates it every time.
__pycache__/
*.pyc
